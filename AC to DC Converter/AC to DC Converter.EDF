   (pin PS1 (rotate 0) 0 -2.54000 0.00000)
   (pin PS1 (rotate 0) 1 0.00000 0.00000)
   (pin PS1 (rotate 0) 2 2.54000 0.00000)
  )
  (image P1_U3 (side front)
