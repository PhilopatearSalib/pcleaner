   (net "#00003"))
  (wire (path TOP 0.25400 -21.59000 57.78500 -21.59000 46.99000) (net "#00003"))
   (wire (path TOP 0.25400 -24.13000 82.55000 -24.13000 76.83500 -24.76500 76.20000 -41.91000 76.20000
